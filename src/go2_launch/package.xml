<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>go2_launch</name>
  <version>1.0.0</version>
  <description>Launch files for Go2 RL locomotion deployment.</description>
  <maintainer email="gabearod2@gmail.com">Gabriel Rodriguez</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>blind_locomotion</exec_depend>
  <exec_depend>rl_deploy</exec_depend>
  <exec_depend>unitree_go</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
